{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/repository-security-audit/file-coverage.schema.json",
  "title": "Repository Security Audit File Coverage",
  "type": "object",
  "required": ["target", "eligible_count", "files"],
  "properties": {
    "target": {"type": "string"},
    "eligible_count": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "eligible", "scanner_coverage"],
        "properties": {
          "path": {"type": "string"},
          "eligible": {"type": "boolean"},
          "exclusion_reason": {"type": ["string", "null"]},
          "manual_status": {
            "type": ["string", "null"],
            "enum": [
              "manually_reviewed",
              "scanner_only",
              "both",
              "unreviewed",
              null
            ]
          },
          "scanner_coverage": {
            "type": "array",
            "items": {"enum": ["Semgrep", "Gitleaks", "OSV-Scanner"]}
          }
        }
      }
    }
  }
}
